# ── JWT AUTHENTICATION ────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_SECONDS=3600

# Staff users JSON (optional — defaults to demo admin/nurse/viewer accounts)
# Replace default passwords before deploying to production!
# Generate password hash: node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
# STAFF_USERS=[{"id":"admin-001","username":"admin","passwordHash":"<sha256>","role":"admin","name":"Admin"}]

# ── SECURITY ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourhospital.com

# ── SERVER ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
